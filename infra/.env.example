# 복사해서 infra/.env 로 쓴다. 비밀값은 커밋하지 않는다. 키 목록 정본: docs/guides/configuration.md.
# 실행 모드(LLM_FAKE·ENABLE_TEST_API·포트·추적)는 infra/profiles/<PROFILE>.env가 이 파일 값을 덮는다
# (`make profile PROFILE=…`로 확인). 이 파일에는 비밀값과 프로필이 정하지 않는 값만 둔다.
# 제한 키. 허용 모델: gpt-4o-mini, gpt-4.1-mini, gpt-5.4-mini, gpt-5.4-nano, gpt-5-nano(목록 밖 gpt-*는 오류)
OPENAI_API_KEY=
# 기본 gpt-4o-mini. 역할별 모델(아래 MODEL_*)이 비어 있으면 이 값을 쓴다
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql+asyncpg://dayzero:dayzero@postgres:5432/dayzero
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# JWT_SECRET: HS256 서명 키. 32바이트 이상의 임의 값으로 바꾼다(짧으면 PyJWT가 경고)
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me-internal
# assessment-mcp 토큰(X-Assessment-Token). api 결정적 노드·report-worker·assessment-mcp만 쓴다. 페르소나에는 주지 않는다
ASSESSMENT_MCP_TOKEN=change-me-assessment

# 서비스 주소(DATABASE_URL·RABBITMQ_URL 포함. compose는 docker-compose.yml environment가 컨테이너 주소로 덮는다. 로컬 실행은 localhost로)
API_INTERNAL_URL=http://api:8001
DEBATE_MCP_URL=http://debate-mcp:9101/mcp
RAG_MCP_URL=http://rag-mcp:9102/mcp
ASSESSMENT_MCP_URL=http://assessment-mcp:9103/mcp

EMBEDDING_MODEL=BAAI/bge-m3
SCENARIOS_DIR=/scenarios
# 세션당 토론 LLM 비용 상한(USD, 기본 2). 넘으면 페르소나는 고정 안전 문구만 말한다(api)
SESSION_COST_HARD_USD=2
# 디브리핑·입장 화면에 보이는 문의 이메일(기본 recruit@example.com)
CONTACT_EMAIL=recruit@example.com
# 장애 주입(e2e 전용, 평소 비움): <역할>:timeout:<횟수> 형식. 예: persona:timeout:1 (api·report-worker)
LLM_FAULT=
# report-worker 헬스 체크 파일(compose healthcheck가 읽음, 기본 /tmp/heartbeat)
HEARTBEAT_PATH=/tmp/heartbeat
# 테스트 API(/internal/test/*: 단계 시드·시간 당기기). 운영은 비운다. 프로필이 덮는다(deploy는 0)
ENABLE_TEST_API=1
# 1이면 api·report-worker의 LLM 호출만 결정적 고정 응답(그래프는 그대로). 프로필이 덮는다(기본 dev-fake는 1)
LLM_FAKE=1
# 토론 에이전트 실행기. session(기본)=토론 그래프, fake=FakeAgentRunner(api 단위 테스트 주입 전용)
AGENT_RUNNER=session
# rag-mcp 모델 캐시(compose 볼륨 hfcache가 여기에 붙음)
HF_HOME=/models
# LangSmith 추적. 기본 끔. test·eval 프로필은 항상 false로 덮는다
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=day-zero
# 실제 API(과금) 호출 동의. make up(실제 LLM 프로필)·eval·measure·live 테스트는 ALLOW_API=1을 명령에 붙인다(여기 두지 않는다)
# ALLOW_API=
# api 공개 앱 CORS 허용 origin. 쉼표로 여러 개
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- 역할별 모델 (비우면 OPENAI_MODEL). 프롬프트 수정으로 품질이 안 나오는 역할만 올린다(사용자 결정) ---
# 키 선택 규칙: 허용 목록의 gpt-*는 OPENAI_API_KEY(제한 키), gemini-*는 GEMINI_API_KEY(OpenAI 호환 엔드포인트),
# 그 밖은 설정 오류. 개인 키 경로는 없다. 코드는 이 규칙만 안다(services/api/app/agent/llm/roles.py)
GEMINI_API_KEY=
MODEL_INTENT=
MODEL_TURN=
MODEL_PERSONA=
MODEL_ASSISTANT=
MODEL_EVALUATOR=
# 판정 모델(귀속·가상 지원자 judge). 기본값 없음: 켤 때만 명시한다(제한 키 모델은 보정 기준 미달, docs/guides/testing.md)
VC_JUDGE_MODEL=
# 페르소나 품질 live에서 귀속 판정을 함께 돌릴지. 기본 0(끔). 1이면 VC_JUDGE_MODEL 필수
PERSONA_EVAL_JUDGE=0

# 음성 토론: 일반 Neural TTS + 표준 ko-KR STT, 유료 폴백 없음.
VOICE_ENABLED=1
VOICE_PROVIDER=azure
# VOICE_PROVIDER=openai·gemini일 때 음성 모델. 비우면 openai는 gpt-4o-mini-transcribe / gpt-4o-mini-tts(키 OPENAI_API_KEY,
# 제한 키 음성 허용 목록), gemini는 gemini-3.5-flash-lite / gemini-2.5-flash-preview-tts(키 GEMINI_API_KEY)
MODEL_STT=
MODEL_TTS=
# 받아 적기와 읽기를 다른 공급자에 맡길 때(비우면 VOICE_PROVIDER). STT는 whisper(로컬)도 된다
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=
# 로컬 받아 적기(VOICE_STT_PROVIDER=whisper, faster-whisper CPU int8). 모델은 /models/whisper에 처음 한 번 내려받는다
WHISPER_MODEL=
WHISPER_THREADS=4
WHISPER_BEAM=1
WHISPER_CONCURRENCY=1
VOICE_USER_TURN_SECONDS=60
# 내 차례가 온 뒤 녹음이 자동으로 시작되기까지의 생각 시간(초, 0~60). 크면 준비 시간이 늘지만 단계 시간을 더 쓴다. 0이면 바로 녹음
VOICE_THINK_SECONDS=5
# 일반 내 차례를 지켜 주는 시간(초, 5~120). 지원자가 [발언하기]를 누를 때까지 기다리고, 지나면 동료가 이어 말한다(손들기로 다시 잡을 수 있음)
VOICE_TURN_HOLD_SECONDS=20
# 받아 적은 글을 보여 주고 자동 제출하기까지의 확인 시간(초, 0~30). 크면 고칠 기회가 늘지만 대화가 늦어진다. 0이면 바로 제출
VOICE_CONFIRM_SECONDS=8
# 강제 차례(단계에서 아직 말 안 한 지원자)가 지금 동료 발언이 끝나기를 기다릴 몫(초, 0~120).
# 강제 차례는 마감 "이 값 + 생각 시간 + 발언 한도 + 10초" 전에 온다. 크면 60초 발언이 잘릴 일이 줄지만 더 일찍 끼어든다
VOICE_FORCED_WAIT_SECONDS=30
# 말하는 동안 받아 적기: 이만큼(초, 4~30) 쌓이면 직전 SEARCH초 안에서 가장 조용한 PAUSE ms 구간에서 잘라 미리 받아 적는다.
# 작으면 녹음 끝 대기가 줄지만 요청이 늘고, 크면 반대. PAUSE가 너무 짧으면 단어 사이에서 잘릴 수 있다
VOICE_SEGMENT_SECONDS=10
VOICE_SEGMENT_SEARCH_SECONDS=4
VOICE_SEGMENT_PAUSE_MS=300
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_RESOURCE_ID=
# 사용량 원장 기간. auto는 UTC 달(YYYY-MM)마다 새 원장. 앱 상한(STT 4시간·TTS 40만 자)이
# F0 무료량(5시간·50만 자)보다 낮아 Azure 리셋과 며칠 어긋나도 흡수된다. 고정 ID를 직접 써도 된다.
VOICE_QUOTA_PERIOD=auto
# Azure DefaultAzureCredential용 서비스 계정(또는 관리 ID/로컬 Azure CLI 로그인).
# F0 조회와 동일 리소스 listKeys 권한만 필요. 요금제 변경 권한은 주지 않는다.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
