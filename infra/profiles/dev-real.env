# 개발 스택을 실제 LLM(제한 키 허용 모델만)으로. 테스트 API 끔. ALLOW_API=1 필요
PROFILE_PURPOSE=dev
PROFILE_COMPOSE_PROJECT=infra
PROFILE_COMPOSE_OVERRIDE=none
VOICE_ENABLED=1
# 음성: 받아 적기는 로컬 Whisper, 읽기는 로컬 Supertonic(목소리 p1 M1·p2 F1·p3 F2). 둘 다 이 서버에서
# 돌아 음성·문장이 밖으로 나가지 않고 과금·키가 없다. 모델은 첫 사용 때 hfcache 볼륨(/models)에 내려받는다.
# 음성을 만들지 못한 발언은 화면이 글로 보여 주고 넘긴다. VOICE_PROVIDER는 둘을 따로 정하지 않을 때의
# 기본값이라 여기서는 쓰이지 않는다(azure·openai·gemini·fake 중 하나여야 해서 둔다)
VOICE_PROVIDER=gemini
VOICE_STT_PROVIDER=whisper
VOICE_TTS_PROVIDER=supertonic
# 음성 사용량 원장 기간(auto = UTC 연-월). Azure 프로필은 infra/.env 값을 쓴다
VOICE_QUOTA_PERIOD=auto
LLM_FAKE=0
ENABLE_TEST_API=0
AGENT_RUNNER=session
API_PORT=8000
WEB_PORT=3000
RABBITMQ_UI_PORT=15672
WEB_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PROFILE_PUBLIC_URL=http://localhost:8000
PROFILE_INTERNAL_URL=http://localhost:8001
PROFILE_WEB_URL=http://localhost:3000
