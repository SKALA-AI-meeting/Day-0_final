# 배포: 실제 LLM(제한 키 허용 모델만), 테스트 API 끔, 가짜 LLM 금지. ALLOW_API=1 필요. 비밀값은 실제 값
# 공개 주소(WEB_ORIGIN·WEB_BASE_URL·NEXT_PUBLIC_*)는 배포 호스트의 infra/.env가 정한다
PROFILE_PURPOSE=deploy
PROFILE_COMPOSE_PROJECT=infra
PROFILE_COMPOSE_OVERRIDE=none
LLM_FAKE=0
ENABLE_TEST_API=0
AGENT_RUNNER=session
API_PORT=8000
WEB_PORT=3000
RABBITMQ_UI_PORT=15672
